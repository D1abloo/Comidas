---
import SiteHeader from './islands/SiteHeader.tsx';
import { getStore } from '../server/db';
const { user } = Astro.locals;
const currentPath = Astro.url.pathname;
const searchQuery = Astro.url.searchParams.get('q') ?? '';
const settings = getStore().settings;
const paymentMethods = [
  settings.cash_enabled && 'efectivo',
  settings.bizum_enabled && 'Bizum',
  settings.tpv_enabled && 'tarjeta',
].filter((method): method is string => Boolean(method));
const paymentLabel = paymentMethods.length
  ? `Paga con ${paymentMethods.join(', ')}`
  : 'Consulta los métodos de pago disponibles';
---
<SiteHeader
  client:load
  user={user ? { id: user.id, full_name: user.full_name, role: user.role } : null}
  currentPath={currentPath}
  searchQuery={searchQuery}
  paymentLabel={paymentLabel}
/>
