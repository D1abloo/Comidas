---
import { isDemoMode } from '../server/env';

const showDemoBanner = isDemoMode();
---
{showDemoBanner && (
  <div class="demo-notice" data-demo-notice role="status">
    <div class="demo-notice-inner">
      <span class="demo-notice-label">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M8.5 12h7M12 8.5v7"></path>
        </svg>
        Modo demo · datos locales de prueba
      </span>
      <details class="demo-access">
        <summary>Ver accesos demo</summary>
        <div class="demo-access-popover">
          <p><strong>Cliente</strong> cliente@bocado.app / cliente1234</p>
          <p><strong>Admin</strong> admin@bocado.app / admin1234</p>
          <p><strong>Repartidor</strong> repartidor@bocado.app / repartidor1234</p>
        </div>
      </details>
      <button type="button" class="demo-notice-close" data-demo-close aria-label="Cerrar aviso de demostración">×</button>
    </div>
  </div>
)}

<script>
  const notice = document.querySelector<HTMLElement>('[data-demo-notice]');
  if (notice) {
    if (sessionStorage.getItem('bocado_demo_notice_hidden') === '1') notice.hidden = true;
    notice.querySelector('[data-demo-close]')?.addEventListener('click', () => {
      notice.hidden = true;
      sessionStorage.setItem('bocado_demo_notice_hidden', '1');
    });
  }
</script>
