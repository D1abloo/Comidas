---
const cats = [
  { icon: 'pizza', label: 'Pizza', href: '/carta/pizza-pasta' },
  { icon: 'bowl', label: 'Asiático', href: '/buscar?cuisine=Asiática' },
  { icon: 'pot', label: 'Cazuelas', href: '/carta/cazuelas' },
  { icon: 'burger', label: 'Burgers', href: '/buscar?cuisine=Burgers' },
  { icon: 'leaf', label: 'Saludable', href: '/buscar?diet=vegan' },
  { icon: 'pasta', label: 'Pasta', href: '/carta/pizza-pasta' },
  { icon: 'drink', label: 'Bebidas', href: '/carta/bebidas' },
  { icon: 'cake', label: 'Postres', href: '/carta/postres' },
];
---
<section class="category-rail-wrap animate-fade-up stagger-2" aria-label="Categorías rápidas">
  <div class="container-bocado">
    <div class="category-rail-heading">
      <h2 class="category-rail-label">Explora por tipo</h2>
      <a href="/carta" class="category-view-all">Ver todos <span aria-hidden="true">→</span></a>
    </div>
    <div class="category-rail scrollbar-hide" role="list">
      <a href="#catalogo" class="category-pill category-pill--active" aria-current="true" role="listitem">
        <span class="category-pill-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1"></rect><rect x="14" y="4" width="6" height="6" rx="1"></rect><rect x="4" y="14" width="6" height="6" rx="1"></rect><rect x="14" y="14" width="6" height="6" rx="1"></rect></svg>
        </span>
        <span class="category-pill-text">Todos</span>
      </a>
      {cats.map((c) => (
        <a href={c.href} class="category-pill" role="listitem">
          <span class="category-pill-icon" aria-hidden="true">
            {c.icon === 'pizza' && <svg viewBox="0 0 24 24"><path d="M5 19 19 5c-4-2-8-2-12 0-3 4-3 9-2 14Z"></path><circle cx="10" cy="10" r="1"></circle><circle cx="8" cy="15" r="1"></circle></svg>}
            {c.icon === 'bowl' && <svg viewBox="0 0 24 24"><path d="M4 11h16c0 5-3 8-8 8s-8-3-8-8ZM8 6c-1 1-1 2 0 3m4-4c-1 1-1 3 0 4m4-3c-1 1-1 2 0 3"></path></svg>}
            {c.icon === 'pot' && <svg viewBox="0 0 24 24"><path d="M5 9h14v9H5zM8 6h8M3 11h2m14 0h2"></path></svg>}
            {c.icon === 'burger' && <svg viewBox="0 0 24 24"><path d="M5 10c0-3 3-5 7-5s7 2 7 5H5Zm0 4h14M6 18h12c1 0 2-2 1-3H5c-1 1 0 3 1 3Z"></path></svg>}
            {c.icon === 'leaf' && <svg viewBox="0 0 24 24"><path d="M19 4C11 4 5 8 5 14c0 3 2 5 5 5 6 0 9-7 9-15ZM6 19c2-4 5-7 10-10"></path></svg>}
            {c.icon === 'pasta' && <svg viewBox="0 0 24 24"><path d="M5 11h14c0 5-3 8-7 8s-7-3-7-8ZM8 5c0 2 1 2 1 4m3-4c0 2 1 2 1 4m3-4c0 2 1 2 1 4"></path></svg>}
            {c.icon === 'drink' && <svg viewBox="0 0 24 24"><path d="M7 7h10l-1 13H8L7 7Zm8 0 2-4m-8 8h7"></path></svg>}
            {c.icon === 'cake' && <svg viewBox="0 0 24 24"><path d="M5 12h14v8H5zM7 12c0-3 2-5 5-5s5 2 5 5M12 7V4"></path></svg>}
          </span>
          <span class="category-pill-text">{c.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>
