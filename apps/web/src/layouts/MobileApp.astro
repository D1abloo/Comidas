---
import '../styles/global.css';
import MobileRouteGuard from '../components/islands/MobileRouteGuard.tsx';
interface Props { title?: string; role: 'admin' | 'courier' }
const { title = 'BocadO', role } = Astro.props as Props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1a2421" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <link rel="manifest" href="/mobile-manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <title>{title}</title>
  </head>
  <body class="mobile-native-shell font-admin">
    <MobileRouteGuard client:load role={role} />
    <slot />
  </body>
</html>
