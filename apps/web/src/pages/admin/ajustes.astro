---
import Admin from '../../layouts/Admin.astro';
import SettingsForm from '../../components/islands/SettingsForm.tsx';
import { getStore } from '../../server/db';
import { areSimulatedPaymentsEnabled, isEmailDeliveryConfigured } from '../../server/env';
const { company, settings } = getStore();
const capabilities = {
  tpv: areSimulatedPaymentsEnabled(),
  email: isEmailDeliveryConfigured(),
  whatsapp: false,
};
---
<Admin title="Ajustes" crumb="Inicio / Ajustes">
  <SettingsForm client:load initialCompany={company} initialSettings={settings} capabilities={capabilities} />
</Admin>
