---
import Admin from '../../layouts/Admin.astro';
import AdminDashboard from '../../components/islands/AdminDashboard.tsx';
import type { DashboardData } from '../../components/islands/AdminDashboard.types';
import { getStore } from '../../server/db';
import { getDashboardSnapshot, listUnseenAlerts } from '../../server/order-service';

const store = getStore();
const [snap, unseenAlerts] = await Promise.all([getDashboardSnapshot(), listUnseenAlerts()]);

const dashboardData: DashboardData = {
  stats: {
    salesToday: snap.salesToday,
    salesMonth: snap.salesMonth,
    ordersToday: snap.ordersToday,
    activeOrders: snap.activeOrders,
    avgTicket: snap.avgTicket,
    pendingBizum: snap.pendingBizum,
    outOfStock: store.dishes.filter((d) => !d.is_available).length,
    unseenAlerts: unseenAlerts.length,
  },
  pipeline: snap.pipeline,
  payments: snap.payments,
  settings: {
    delivery_fee_cents: store.settings.delivery_fee_cents,
    free_delivery_from_cents: store.settings.free_delivery_from_cents,
    bizum_phone: store.settings.bizum_phone,
    delivery_enabled: true,
  },
  topDishes: snap.topDishes,
  series: snap.series.map(({ d, total, label }) => ({ d, total, label })),
  recentOrders: snap.recentOrders,
};
---
<Admin title="Dashboard" crumb="Inicio / Dashboard">
  <AdminDashboard client:load data={dashboardData} />
</Admin>
