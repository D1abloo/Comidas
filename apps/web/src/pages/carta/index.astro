---
import Base from '../../layouts/Base.astro';
import CatalogBrowse from '../../components/islands/CatalogBrowse.tsx';
import { getStore } from '../../server/db';

const store = getStore();
const sections = store.menu_sections
  .filter((s) => s.is_active && s.id !== 'sec-menu-dia')
  .sort((a, b) => a.sort_order - b.sort_order);

const dishes = store.dishes.filter((d) => d.menu_section_id !== 'sec-menu-dia');
const restaurants = Object.fromEntries(store.restaurants.map((r) => [r.id, r.name]));
const initialSection = Astro.url.searchParams.get('seccion') ?? '';
---
<Base title="Carta completa — BocadO" description="Todos los platos con filtros por sección, precio y dieta.">
  <section class="container-bocado py-10 md:py-14 pb-28">
    <nav class="text-sm text-bocado-mute mb-6">
      <a href="/" class="hover:text-bocado-ink">Inicio</a>
      <span class="mx-2">/</span>
      <span class="text-bocado-ink font-medium">Carta</span>
    </nav>

    <header class="mb-8 md:mb-10">
      <p class="premium-eyebrow">Carta completa</p>
      <h1 class="premium-title mt-2">Todos los platos</h1>
      <p class="premium-sub mt-3 max-w-2xl">
        Filtra por sección, precio y dieta. También puedes descargar la
        <a href="/api/carta.pdf" class="underline font-semibold text-bocado-ink" target="_blank" rel="noopener">carta PDF</a>.
      </p>
    </header>

    <CatalogBrowse
      client:load
      dishes={dishes}
      sections={sections.map((s) => ({ id: s.id, title: s.title, slug: s.slug }))}
      restaurants={restaurants}
      initialSection={initialSection}
    />
  </section>
</Base>
