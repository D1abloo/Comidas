# —— App ——
PUBLIC_APP_URL=http://localhost:4321
SESSION_SECRET=genera-un-secreto-largo-aleatorio
ORDER_TOKEN_SECRET=genera-otro-secreto-distinto-y-largo
ALLOW_ADMIN_REGISTRATION=false
APP_DEMO_MODE=true
ENABLE_SIMULATED_PAYMENTS=false
BOCADO_DATA_DIR=

# PostgreSQL local (Docker: npm run deploy:vps o docker compose up)
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5

# Bizum (también editable en /admin/ajustes)
BIZUM_COMPANY_PHONE=

# —— Email al confirmar pedido ——
EMAIL_ENABLED=false
# Desarrollo: console. Producción: resend.
EMAIL_PROVIDER=console
EMAIL_FROM="BocadO <pedidos@tudominio.com>"
EMAIL_REPLY_TO=soporte@tudominio.com
EMAIL_API_KEY=
